        },
        {
          "contents": "",
          "post_id": "55889",
          "text": "\n<p>&nbsp;_______ is not an E-Commerce application</p>\n\n<ol style=\"list-style-type: upper-alpha;\"><li>House banking</li>\n    <li><span style=\"line-height: 1.6;\">Buying stocks</span></li>\n    <li><span style=\"line-height: 1.6;\">Conducting an auction</span></li>\n    <li><span style=\"line-height: 1.6;\">Evaluating an employee</span></li>\n</ol>\n",
